{
  "name": "obsidian-pack-movies",
  "version": "1.0.0",
  "description": "TNR - Track 'n' Review: busca filmes/séries no TMDB e insere cards com embed (com ou sem elenco) no cursor.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "release": "npm run build"
  },
  "keywords": [
    "obsidian",
    "tmdb",
    "movies",
    "tv",
    "tnr"
  ],
  "author": "Lucas",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  }
}
